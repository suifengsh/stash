name: SSID
desc: 自用

proxy-groups:
  - name: SSID
    type: select
    proxies:
      - Home-fn
      - Home-ds
      - DIRECT
    ssid-policy:
      "SamHome5G": DIRECT  
      "SamHome": DIRECT  
      cellular: Home-fn
      default: Home-fn

rules:
  - DOMAIN-SUFFIX,zte.home,SSID,no-resolve
  - IP-CIDR,192.168.1.0/24,SSID,no-resolve #!replace
